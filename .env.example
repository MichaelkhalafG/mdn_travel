# ─────────────────────────────────────────────────────────────────────────
# MDN Travel — environment reference
# Copy to .env for local dev; on Hostinger paste these into the Node.js app's
# Environment Variables panel (see DEPLOY.md). NEVER commit a filled-in .env.
# ─────────────────────────────────────────────────────────────────────────

# Database — Prisma + MySQL.
# Local dev (XAMPP/MariaDB or docker compose): mysql://root:root@localhost:3306/mdn_travel
# Production (Hostinger managed MySQL): use the DB name / user / password from
# hPanel → Databases → MySQL. Host is usually "localhost" for same-server DBs.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"

# Auth.js (NextAuth) — ADMIN ONLY. There is no public user auth.
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=""
# AUTH_URL: the canonical public origin. Must be the real https origin in prod.
AUTH_URL="https://travel.mdneg.com"
# AUTH_TRUST_HOST: required so Auth.js trusts the forwarded host behind
# Hostinger's reverse proxy. (The code also sets trustHost:true as a fallback.)
AUTH_TRUST_HOST="true"

# Public canonical origin — used as metadataBase so Open Graph / Twitter image
# URLs resolve absolutely (og.jpg) instead of pointing at localhost in prod.
NEXT_PUBLIC_SITE_URL="https://travel.mdneg.com"

# Admin account — created/reset by `npm run create-admin` (and the dev seed).
# Use a strong password in production; this is the only way into /admin.
ADMIN_EMAIL="admin@mdn.example"
ADMIN_PASSWORD="change-me"

# Public contact shown in the footer / privacy page. Defaults live in
# src/lib/company.ts and are the REAL values from mdn.international/contact/
# (main phone +966 125124965, email info@mdn.International). Override only if
# MDN Travel gets its own dedicated channels.
NEXT_PUBLIC_CONTACT_PHONE="+966 12 512 4965"
NEXT_PUBLIC_CONTACT_EMAIL="info@mdn.international"

# Optional: set to 1 to log every Prisma query with its duration (perf debug).
# Leave unset / "0" in production.
PRISMA_LOG="0"
