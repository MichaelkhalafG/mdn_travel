# MySQL connection string used by Prisma (Hostinger managed MySQL in production)
DATABASE_URL="mysql://user:password@localhost:3306/mdn_travel"

# Auth.js (NextAuth) secret — generate with: npx auth secret
AUTH_SECRET=""

# Admin account created by the seed script (prisma/seed.ts).
# Auth is ADMIN ONLY — there are no public user accounts.
ADMIN_EMAIL="admin@mdn.example"
ADMIN_PASSWORD="change-me"

# Public contact shown in the footer / privacy page. Defaults (in
# src/lib/company.ts) are the REAL values from https://mdn.international/contact/
# — main phone +966 125124965, email info@mdn.International. Override here only
# if MDN Travel gets its own dedicated contact channels.
NEXT_PUBLIC_CONTACT_PHONE="+966 12 512 4965"
NEXT_PUBLIC_CONTACT_EMAIL="info@mdn.international"
